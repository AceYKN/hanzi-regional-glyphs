{
  "name": "hanzi-regional-glyphs",
  "version": "0.1.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/AceYKN/hanzi-regional-glyphs.git"
  },
  "homepage": "https://hanzi-regional-glyphs.pages.dev/",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run data:build && tsc --noEmit && vite build && node scripts/build-service-worker.mjs",
    "preview": "vite preview",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist",
    "data:build": "tsx scripts/build-readings.ts",
    "data:unihan": "python scripts/build-unihan.py",
    "data:fonts": "python scripts/build-fonts.py"
  },
  "dependencies": {
    "opencc-js": "1.4.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.18.2",
    "wanakana": "5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.3.4",
    "wrangler": "4.150.0"
  },
  "type": "module"
}
